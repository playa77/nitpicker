        "viewName": "segmentation_pending",
        "createSql": "CREATE VIEW `${VIEW_NAME}` AS SELECT c.* FROM audio_chunks c WHERE c.state='ASR_DONE' AND NOT EXISTS (SELECT 1 FROM analysis_jobs j WHERE j.session_id=c.session_id AND j.reason='CHUNK' AND j.chunk_seq=c.seq)"
      }
